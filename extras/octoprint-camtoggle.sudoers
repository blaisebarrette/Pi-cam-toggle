# Copier dans /etc/sudoers.d/octoprint-camtoggle (chmod 440), puis valider : sudo visudo -c
# Adapter l'utilisateur (pi) et le(s) service(s) à votre installation.
pi ALL=(root) NOPASSWD: /usr/bin/systemctl start camera-streamer-libcamera, \
                        /usr/bin/systemctl stop camera-streamer-libcamera, \
                        /usr/bin/systemctl enable camera-streamer-libcamera, \
                        /usr/bin/systemctl disable camera-streamer-libcamera
