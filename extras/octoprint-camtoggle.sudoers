# Inutile sur OctoPi (« sudo service » y est déjà autorisé).
# Ailleurs : copier dans /etc/sudoers.d/octoprint-camtoggle (chmod 440), puis valider : sudo visudo -c
# Adapter l'utilisateur (pi) et le service (webcamd).
pi ALL=(root) NOPASSWD: /usr/bin/systemctl start webcamd, /usr/bin/systemctl stop webcamd
